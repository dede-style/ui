{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "declaration": true,
    "rootDir": ".",
    "outDir": "dist",
    "noEmit": false
  },
  "include": ["index.ts", "components/**/*", "icons/**/*"],
  "exclude": ["dist", "**/*.controls.ts"]
}
